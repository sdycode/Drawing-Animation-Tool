rules_version = '2';

// ============================================================================
// Firestore security rules for the "Annimation" (animated_icon_demo) web app.
//
// IMPORTANT — NOT DEPLOYED AUTOMATICALLY. This file is an artifact. It only
// takes effect when you run `firebase deploy --only firestore:rules`. Review
// it (and the legacy section below) before deploying to a project that still
// serves the OLD app.
//
// Design goal: scope the new `appData/v2` namespace WITHOUT breaking anything
// that already exists. The legacy top-level `users/...` tree is left exactly
// as permissive as it is today, so the old deployment keeps working and no
// existing data is touched.
//
// Phase 3 (when firebase_auth + uid re-keying land): tighten the `appData/v2`
// rule from `if true` to `if request.auth.uid == username` and add a
// public-read carve-out (`allow read: if resource.data.isPublic == true;`).
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Legacy v1 data: preserved as-is -----------------------------------
    // The old app has no auth and relies on open access. We deliberately do
    // NOT freeze it here, to avoid breaking the existing deployment or
    // "touching" existing data. Tighten or remove this block only once the
    // old app is fully retired.
    match /users/{document=**} {
      allow read, write: if true;
    }

    // --- New v2 namespace: all version-2 data lives here --------------------
    // appData/v2/users/{username}/Project_{n}/Project_{n}
    match /appData/v2/users/{username}/{document=**} {
      // Phase 0 (pre-auth) rollout: permissive, same as legacy default.
      // Phase 3 (post-auth): replace with `if request.auth.uid == username;`
      allow read, write: if true;
    }

    // --- Everything else: denied -------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
