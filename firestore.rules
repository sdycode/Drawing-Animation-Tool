rules_version = '2';

// ============================================================================
// Firestore security rules — v3.
//
// NOT DEPLOYED AUTOMATICALLY. Takes effect only on:
//   firebase deploy --only firestore:rules
//
// Three namespaces share one Firebase project and never overlap:
//   users/...            legacy v1  — the still-deployed old app
//   appData/v2/...       v2 branch  — abandoned, left readable
//   appData/v3/...       THIS APP   — uid-scoped, auth required
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // --- v3: the only namespace this app reads or writes -------------------
    // appData/v3/users/{uid}/projects/{projectId}
    //
    // AC-10.0.6: uid scoping is enforced HERE, server-side. A client-side check
    // is a UI affordance, not a security boundary — user A must not be able to
    // read user B's projects by editing a path in devtools.
    match /appData/v3/users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // --- Legacy v1: preserved exactly as-is --------------------------------
    // The old app has no auth and relies on open access. Deliberately NOT
    // tightened: the old deployment is still live and its data is never
    // migrated (docs/v3/02 §8). Remove this block only once it is retired.
    match /users/{document=**} {
      allow read, write: if true;
    }

    // --- v2: abandoned branch, left as it was ------------------------------
    match /appData/v2/{document=**} {
      allow read, write: if true;
    }

    // --- Everything else: denied -------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
