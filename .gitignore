# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
# The leading slash above anchors to the repo root, so it never covered the
# per-package build/ that `flutter test` drops into packages/anim_render/ the
# first time the renderer's widget tests run. Left unignored, a routine
# `git add -A` commits a dill cache and native_assets.json and every later
# checkout fights the toolchain over them.
packages/*/build/

# Web related

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# v3 is Flutter WEB ONLY (docs/v3/00 §6). `flutter pub get` regenerates these
# platform folders on every run; they are not part of the project and must never
# be committed again.
/android/
/ios/
/macos/
/linux/
/windows/
